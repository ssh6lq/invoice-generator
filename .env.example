# === AI 모델 연결 (영수증 파싱) ===
# OpenAI 호환 엔드포인트. 기본값은 사내 vLLM 프록시.
RECEIPT_PROVIDER=로컬 서버
RECEIPT_BASE_URL=http://192.168.1.51:8000
RECEIPT_MODEL=vllm-qwen
# Bearer 토큰(= api_key). OpenAI를 쓸 경우 OPENAI_API_KEY 로 넣어도 됨.
RECEIPT_API_KEY=
# 영수증 동시 분석 장수. 모델 서버가 넉넉하면 올려도 되지만,
# 너무 크게 잡으면 큐잉/타임아웃으로 오히려 느려진다.
RECEIPT_CONCURRENCY=4

# === 관리자 페이지(문의/제출 내역) 보호 ===
ADMIN_USER=admin
ADMIN_PASSWORD=
